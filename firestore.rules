rules_version = '2';

// Data model: users/{uid}/atomicHabits/{identities|checkIns|dailyTasks}
// Every document a user reads or writes must live under their own uid —
// no cross-user access, and no access at all while signed out.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/atomicHabits/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Web-push tokens for habit reminders. The reminder Cloud Function reads these
    // via the Admin SDK (which bypasses rules); users only touch their own.
    // Legacy single-doc form (kept so old writes still validate):
    match /pushTokens/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Per-device tokens — one doc per device so every device gets reminders.
    match /pushTokens/{uid}/devices/{deviceId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Default-deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
