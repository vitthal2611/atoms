rules_version = '2';

// Data model: users/{uid}/atomicHabits/{identities|checkIns|dailyTasks}
// Every document a user reads or writes must live under their own uid —
// no cross-user access, and no access at all while signed out.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/atomicHabits/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Web-push tokens for habit reminders. The reminder Cloud Function reads these
    // via the Admin SDK (which bypasses rules); users only touch their own.
    // Legacy single-doc form (kept so old writes still validate):
    match /pushTokens/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Per-device tokens — one doc per device so every device gets reminders.
    match /pushTokens/{uid}/devices/{deviceId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Tribe cohorts (anonymous aggregate social proof). A member doc holds only
    // { d: "YYYY-MM-DD" } — no names or emails. Any signed-in user may read (to
    // compute aggregate counts); each user may write only their own member doc,
    // and only that single field.
    match /cohorts/{cohortKey}/members/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['d']);
    }

    // Default-deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
